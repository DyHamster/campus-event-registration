@startuml
!pragma layout smetana
!include _style.iuml
title UML 组件图 · 系统模块

rectangle "校园活动票务与报名系统" {
  component "<b>用户与权限管理</b>\n身份与角色" as Auth
  component "<b>活动与票务管理</b>\n创建、审核、发布与取消" as Event
  component "<b>活动查询与展示</b>\n公开活动与个人记录" as Query
  component "<b>报名与候补管理</b>\n报名、取消与递补" as Registration
  component "<b>电子票与检票管理</b>\n票据核验与签到" as Ticket
  component "<b>数据管理</b>\n名单导出、统计与日志" as Data #E9E9E9
  database "数据库" as Database

  Auth -[hidden]right-> Event
  Event -[hidden]right-> Query
  Query -[hidden]right-> Registration
  Auth --> Data
  Event --> Data
  Query --> Data
  Registration --> Data
  Ticket --> Data
  Registration -right-> Ticket : 出票与作废
  Data --> Database
}
@enduml

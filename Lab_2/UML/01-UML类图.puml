@startuml
!pragma layout smetana
!include _style.iuml
title UML 类图 · 活动报名与票务
hide circle
hide empty methods

class "用户" as User {
  姓名
  角色
}

class "活动" as Event {
  名称
  发布状态
  报名条件
  --
  提交审核()
  取消活动()
}

class "场次" as Session {
  时间
  地点
  容量
  报名截止时间
}

class "报名类别" as Category {
  名称
  票价
}

class "报名记录" as Registration {
  报名状态
  接收顺序
  --
  确认报名()
  取消报名()
}

class "电子票" as Ticket {
  票码
  票据状态
}

class "签到记录" as CheckIn {
  签到时间
}

User "1" -down- "0..*" Event : 创建
Event "1" *-right- "0..*" Session : 包含
Session "1" *-right- "0..*" Category : 设置
User "1" -right- "0..*" Registration : 提交
Session "1" -up- "0..*" Registration
Category "1" -up- "0..*" Registration : 所选类别
Registration "1" -right- "0..1" Ticket : 出票
Ticket "1" -right- "0..1" CheckIn : 签到
@enduml

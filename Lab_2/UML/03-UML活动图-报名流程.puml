@startuml
!include _style.iuml
title UML 活动图 · 报名流程

start
:选择场次和类别，提交报名;
if (同场次已有有效报名或候补？) then (无)
else (有)
  :显示原记录;
  stop
endif
if (活动开放、未截止且符合资格？) then (是)
else (否)
  #EDEDED:显示拒绝原因;
  stop
endif
if (还有名额？) then (有)
  #E3E3E3:确认报名，生成电子票;
else (无)
  if (愿意候补？) then (是)
    #EDEDED:按接收顺序加入候补;
  else (否)
    :提示名额已满;
  endif
endif
stop
@enduml
